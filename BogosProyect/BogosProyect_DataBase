-- 1. Agregar campos fiscales a la tabla de Clientes (CFDI 4.0)
ALTER TABLE clientes 
  ADD COLUMN rfc VARCHAR(13) NULL AFTER telefono,
  ADD COLUMN razon_social VARCHAR(150) NULL AFTER rfc,
  ADD COLUMN codigo_postal_fiscal VARCHAR(5) NULL AFTER razon_social,
  ADD COLUMN regimen_fiscal VARCHAR(3) NULL AFTER codigo_postal_fiscal,
  ADD COLUMN uso_cfdi VARCHAR(3) NULL AFTER regimen_fiscal,
  ADD COLUMN correo_facturacion VARCHAR(150) NULL AFTER uso_cfdi;

-- 2. Crear tabla para la configuración fiscal de la Empresa Emisor
CREATE TABLE IF NOT EXISTS empresa_emisor (
  id_empresa       INT UNSIGNED NOT NULL AUTO_INCREMENT,
  rfc              VARCHAR(13) NOT NULL,
  razon_social     VARCHAR(150) NOT NULL,
  regimen_fiscal   VARCHAR(3) NOT NULL,
  codigo_postal    VARCHAR(5) NOT NULL,
  serie_factura    VARCHAR(5) DEFAULT 'F',
  folio_siguiente  INT UNSIGNED DEFAULT 1,
  logo_url         VARCHAR(255) NULL,
  PRIMARY KEY (id_empresa)
) ENGINE=InnoDB;

-- 3. Ampliar la tabla de Facturas para timbrado simulado (SAT)
ALTER TABLE facturas
  ADD COLUMN serie VARCHAR(5) NULL AFTER id_factura,
  ADD COLUMN uuid VARCHAR(36) NULL AFTER folio,
  ADD COLUMN sello_emisor TEXT NULL AFTER uuid,
  ADD COLUMN sello_sat TEXT NULL AFTER sello_emisor,
  ADD UNIQUE KEY uq_facturas_uuid (uuid);

-- 4. Agregar forma de pago en Pedidos (Logística/Cobro)
ALTER TABLE pedidos 
  ADD COLUMN forma_pago ENUM('Efectivo', 'Tarjeta', 'Transferencia') NOT NULL DEFAULT 'Efectivo' AFTER total;

-- 5. Agregar forma de pago en Ventas (Facturación/Contabilidad)
ALTER TABLE ventas 
  ADD COLUMN forma_pago ENUM('Efectivo', 'Tarjeta', 'Transferencia') NOT NULL DEFAULT 'Efectivo' AFTER total;


